{% extends 'base.html.twig' %}

{% block title %}Créer un compte employé{% endblock %}

{% block body %}
    <main class="admin-page employee-account-page">
        <header class="admin-header">
            <p class="admin-eyebrow">Administration</p>
            <h1>Créer un compte employé</h1>
            <p>
                Créez un accès sécurisé pour un nouveau membre
                de l’équipe.
            </p>
        </header>

        {% for message in app.flashes('success') %}
            <div class="admin-success" role="status">
                {{ message }}
            </div>
        {% endfor %}

        <section class="admin-card employee-account-card">
            {{ form_start(employeeForm, {
                attr: {class: 'employee-account-form'}
            }) }}
                {{ form_errors(employeeForm) }}

                {{ form_row(employeeForm.email) }}
                {{ form_row(employeeForm.plainPassword) }}

                <div class="employee-account-actions">
                    <button type="submit" class="admin-primary-button">
                        Créer le compte employé
                    </button>

                    <a href="{{ path('app_admin') }}">
                        Annuler
                    </a>
                </div>
            {{ form_end(employeeForm) }}
        </section>
    </main>
{% endblock %}