{% extends 'base.html.twig' %}

{% block title %}E-mail envoyé{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-card">
            <div class="auth-brand">Vite &amp; Gourmand</div>

            <div class="auth-heading">
                <p class="auth-eyebrow">Espace client</p>
                <h1>Consultez votre messagerie</h1>
                <p>
                    Si un compte correspond à cette adresse, un e-mail contenant
                    un lien de réinitialisation vient d’être envoyé.
                </p>
            </div>

            <p>
                Ce lien expirera dans
                {{ resetToken.expirationMessageKey|trans(
                    resetToken.expirationMessageData,
                    'ResetPasswordBundle'
                ) }}.
            </p>

            <p class="auth-footer">
                Vous n’avez rien reçu ?
                Vérifiez vos courriers indésirables ou
                <a href="{{ path('app_forgot_password_request') }}">réessayez</a>.
            </p>
        </section>
    </main>
{% endblock %}