{% apply inline_css(source('@styles/emails/account.css')) %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation de votre mot de passe</title>
</head>

<body class="email-body">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="email-background">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="email-shell">
                    <tr>
                        <td class="email-header">
                            <span class="email-brand">Vite &amp; Gourmand</span>
                        </td>
                    </tr>

                    <tr>
                        <td class="email-content">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td class="email-eyebrow">Espace client</td>
                                </tr>

                                <tr>
                                    <td class="email-title">
                                        Réinitialisez votre mot de passe
                                    </td>
                                </tr>

                                <tr>
                                    <td class="email-text">
                                        Une demande de réinitialisation a été effectuée pour votre compte.
                                    </td>
                                </tr>

                                <tr>
                                    <td class="email-text">
                                        Ce lien expirera dans
                                        {{ resetToken.expirationMessageKey|trans(
                                            resetToken.expirationMessageData,
                                            'ResetPasswordBundle'
                                        ) }}.
                                    </td>
                                </tr>

                                <tr>
                                    <td height="16"></td>
                                </tr>

                                <tr>
                                    <td>
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td class="email-button-cell">
                                                    <a
                                                        href="{{ url('app_reset_password', {token: resetToken.token}) }}"
                                                        class="email-button"
                                                    >
                                                        Choisir un nouveau mot de passe
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td height="24"></td>
                                </tr>

                                <tr>
                                    <td class="email-text">
                                        Si vous n’êtes pas à l’origine de cette demande,
                                        vous pouvez ignorer cet e-mail.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td class="email-footer">
                            À bientôt,<br>
                            L’équipe Vite &amp; Gourmand
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
{% endapply %}