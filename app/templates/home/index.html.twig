{% extends 'public.html.twig' %}

{% block title %}Vite & Gourmand | Traiteur à Bordeaux{% endblock %}

{% block public_body %}
    <main class="home-page">
        <section class="home-hero section-shell" aria-labelledby="hero-title">
            <div class="home-hero__content">
                <p class="eyebrow">Traiteur à Bordeaux depuis 27 ans</p>
                <h1 id="hero-title">Des moments gourmands, préparés avec passion</h1>
                <p class="home-hero__intro">
                    Julie et José imaginent des menus qui évoluent au fil des saisons pour les repas de famille,
                    les célébrations et les événements particuliers.
                </p>
                <div class="button-group">
                    <a class="button button--primary" href="{{ path('app_menu') }}">Découvrir nos menus <span aria-hidden="true">→</span></a>
                    <a class="button button--outline" href="#contact">Nous contacter</a>
                </div>
                <p class="home-hero__trust">
                    <span class="icon-disc"><img src="{{ asset('icons/home/badge-check.svg') }}" alt=""></span>
                    27 ans d’expérience · Produits soigneusement sélectionnés
                </p>
            </div>
            <div class="home-hero__visual">
                <img src="{{ asset('images/home/hero.webp') }}" width="1152" height="928" fetchpriority="high" alt="Table généreusement dressée avec un menu Vite & Gourmand">
                <div class="home-hero__signature">
                    <img src="{{ asset('images/home/founders-badge.webp') }}" width="64" height="64" alt="Portrait de Julie et José">
                    <span><strong>Julie &amp; José</strong><small>Vos traiteurs depuis 1999</small></span>
                </div>
            </div>
        </section>

        <section class="home-section home-section--white" id="menus" aria-labelledby="menus-title">
            <div class="section-shell">
                <div class="section-heading section-heading--split">
                    <div>
                        <p class="eyebrow">La carte du moment</p>
                        <h2 id="menus-title">Des menus inspirés par la saison</h2>
                        <p>Des recettes généreuses, cuisinées dans notre atelier bordelais et pensées pour se partager.</p>
                    </div>
                    <a class="button button--outline section-heading__action" href="{{ path('app_menu') }}">Voir tous les menus</a>
                </div>

                <div class="menu-preview-grid">
                    {% set menus = [
                        { image: 'menu-spring.webp', badge: 'Nouveau', slug: 'dejeuner-de-printemps', title: 'Déjeuner de printemps', price: 'Dès 24 €/pers.', description: 'Asperges rôties, volaille fermière aux herbes et tarte fine aux fraises.' },
                        { image: 'menu-bordeaux.webp', badge: 'Le favori', slug: 'table-bordelaise', title: 'Table bordelaise', price: 'Dès 32 €/pers.', description: 'Gravlax de truite, canard confit revisité et canelé au chocolat noir.' },
                        { image: 'menu-vegetarian.webp', badge: 'Végétal', slug: 'jardin-gourmand', title: 'Jardin gourmand', price: 'Dès 22 €/pers.', description: 'Légumes rôtis, céréales parfumées, herbes fraîches et dessert fruité.' }
                    ] %}
                    {% for menu in menus %}
                        <article class="menu-preview-card">
                            <div class="menu-preview-card__image">
                                <img src="{{ asset('images/home/' ~ menu.image) }}" width="1200" height="896" loading="lazy" decoding="async" alt="{{ menu.title }}">
                                <span>{{ menu.badge }}</span>
                            </div>
                            <div class="menu-preview-card__content">
                                <div class="menu-preview-card__heading">
                                    <h3>{{ menu.title }}</h3>
                                    <strong>{{ menu.price }}</strong>
                                </div>
                                <p>{{ menu.description }}</p>
                                <a href="{{ path('app_menu_show', {slug: menu.slug}) }}">Voir le menu <span aria-hidden="true">→</span></a>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <a class="button button--outline home-mobile-only" href="{{ path('app_menu') }}">Voir tous les menus</a>
            </div>
        </section>

        <section class="home-section occasions" aria-labelledby="occasions-title">
            <div class="section-shell">
                <div class="section-heading section-heading--centered">
                    <p class="eyebrow">Pour chaque occasion</p>
                    <h2 id="occasions-title">À vos côtés, des petits repas aux grandes occasions</h2>
                    <p>Une cuisine généreuse et soignée pour les moments qui comptent.</p>
                </div>
                <div class="occasion-grid">
                    {% set occasions = [
                        { icon: 'users.svg', title: 'Repas de famille', text: 'Pour se retrouver autour d’une table généreuse.' },
                        { icon: 'party.svg', title: 'Célébrations', text: 'Mariages, anniversaires et grands moments.' },
                        { icon: 'heart.svg', title: 'Moments entre amis', text: 'Des menus conviviaux faciles à partager.' },
                        { icon: 'briefcase.svg', title: 'Événements professionnels', text: 'Des prestations soignées pour votre entreprise.' }
                    ] %}
                    {% for occasion in occasions %}
                        <article class="occasion-card">
                            <span class="icon-disc"><img src="{{ asset('icons/home/' ~ occasion.icon) }}" alt=""></span>
                            <h3>{{ occasion.title }}</h3>
                            <p>{{ occasion.text }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="home-section home-section--white story" id="histoire" aria-labelledby="story-title">
            <div class="section-shell story__layout">
                <div class="story__images">
                    <img class="story__main-image" src="{{ asset('images/home/founders.webp') }}" width="928" height="1152" loading="lazy" decoding="async" alt="Julie et José dans leur atelier">
                    <img class="story__detail-image" src="{{ asset('images/home/kitchen-detail.webp') }}" width="1024" height="1024" loading="lazy" decoding="async" alt="Préparation d’un plat dans l’atelier">
                </div>
                <div class="story__content">
                    <p class="eyebrow">Notre histoire</p>
                    <h2 id="story-title">Julie, José et 27 ans de cuisine partagée</h2>
                    <p>
                        Vite &amp; Gourmand est né en 1999 d’une envie simple : préparer une cuisine sincère,
                        généreuse et adaptée aux moments importants de la vie.
                    </p>
                    <p>
                        Aujourd’hui encore, Julie et José imaginent chaque menu ensemble et travaillent avec
                        une équipe attentive, des producteurs de confiance et des ingrédients choisis au fil des saisons.
                    </p>
                    <a class="text-link" href="#engagements">Découvrir nos engagements
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="home-section commitments" id="engagements" aria-labelledby="commitments-title">
            <div class="section-shell commitments__layout">
                <div class="commitments__content">
                    <p class="eyebrow">Nos engagements</p>
                    <h2 id="commitments-title">Le goût du bon, le respect du vivant</h2>
                    <p>Une cuisine responsable, préparée avec exigence et simplicité.</p>
                    <ul class="commitment-list">
                        <li>
                            <img src="{{ asset('icons/home/sprout.svg') }}" alt="">
                            <span><strong>Produits locaux et de saison</strong>Nous privilégions les circuits courts dès que possible.</span>
                        </li>
                        <li>
                            <img src="{{ asset('icons/home/map-pin.svg') }}" alt="">
                            <span><strong>Fait maison à Bordeaux</strong>Chaque plat est préparé dans notre atelier.</span>
                        </li>
                        <li>
                            <img src="{{ asset('icons/home/recycle.svg') }}" alt="">
                            <span><strong>Moins de gaspillage</strong>Les quantités sont pensées au plus juste.</span>
                        </li>
                    </ul>
                </div>
                <img class="commitments__image" src="{{ asset('images/home/seasonal-products.webp') }}" width="1024" height="1024" loading="lazy" decoding="async" alt="Table de produits frais et de saison">
            </div>
        </section>

        <section class="home-section home-section--white process" aria-labelledby="process-title">
            <div class="section-shell">
                <div class="section-heading section-heading--centered">
                    <p class="eyebrow">Simple et humain</p>
                    <h2 id="process-title">Votre repas, en quatre étapes</h2>
                    <p>Nous vous accompagnons de la première idée jusqu’au moment de passer à table.</p>
                </div>
                <ol class="process-grid">
                    <li><span>01</span><h3>Choisissez</h3><p>Découvrez nos menus et trouvez votre inspiration.</p></li>
                    <li><span>02</span><h3>Échangeons</h3><p>Parlons de votre événement et de vos besoins.</p></li>
                    <li><span>03</span><h3>Nous cuisinons</h3><p>Notre équipe prépare votre repas avec soin.</p></li>
                    <li><span>04</span><h3>Savourez</h3><p>Profitez pleinement de votre moment gourmand.</p></li>
                </ol>
                <div class="process__action"><a class="button button--primary" href="#contact">Parler de votre projet</a></div>
            </div>
        </section>

        <section class="home-section testimonials" aria-labelledby="testimonials-title">
            <div class="section-shell">
                <div class="section-heading section-heading--centered section-heading--light">
                    <p class="eyebrow">Ils nous font confiance</p>
                    <h2 id="testimonials-title">Ils nous confient leurs plus beaux moments</h2>
                </div>
                <div class="testimonial-grid">
                    <blockquote>
                        <div class="stars" aria-label="5 étoiles">★★★★★</div>
                        <p>« Tout était délicieux, raffiné et généreux. Nos invités ont adoré et nous avons profité pleinement de notre dîner. »</p>
                        <footer>
                            <strong>Camille &amp; Thomas</strong>
                            <span>Mariage · Bordeaux</span>
                        </footer>
                    </blockquote>
                    <blockquote>
                        <div class="stars" aria-label="5 étoiles">★★★★★</div>
                        <p>« Une équipe à l’écoute, des produits impeccables et une présentation magnifique. Le buffet végétal a fait l’unanimité. »</p>
                        <footer>
                            <strong>Sophie Martin</strong>
                            <span>Réception professionnelle · Mérignac</span>
                        </footer>
                    </blockquote>
                </div>
                <p class="testimonials__score">4,9/5 sur 186 avis vérifiés</p>
            </div>
        </section>

        <section class="home-section service-area" aria-labelledby="service-title">
            <div class="section-shell service-area__layout">
                <div class="service-area__map">
                    <img src="{{ asset('images/home/service-area.webp') }}" width="1200" height="896" loading="lazy" decoding="async" alt="Vue de Bordeaux, zone desservie par Vite & Gourmand">
                    <span><img src="{{ asset('icons/home/map-pin-light.svg') }}" alt="">Bordeaux</span>
                </div>
                <div>
                    <p class="eyebrow">Près de chez vous</p>
                    <h2 id="service-title">Bordeaux et sa métropole, livrés avec soin</h2>
                    <p>Nous livrons à Bordeaux et dans un rayon d’environ 35 km. Pour les événements plus éloignés, parlons-en.</p>
                    <div class="location-list">
                        <span>Bordeaux</span>
                        <span>Mérignac</span>
                        <span>Pessac</span>
                        <span>Talence</span>
                        <span>Le Bouscat</span>
                        <span>Bègles</span>
                    </div>
                    <p class="delivery-note">
                        <img src="{{ asset('icons/home/truck.svg') }}" alt="">
                        Livraison offerte à Bordeaux dès 180 €
                    </p>
                </div>
            </div>
        </section>

        <section class="final-cta" id="contact" aria-labelledby="contact-title">
            <div class="section-shell final-cta__layout">
                <div>
                    <p class="eyebrow">Une occasion en vue ?</p>
                    <h2 id="contact-title">Faisons de votre prochain repas un souvenir gourmand</h2>
                    <p>Racontez-nous votre projet. Nous vous répondons sous 24 à 48 h avec une proposition claire et savoureuse.</p>
                    <div class="button-group">
                        <a class="button button--light" href="mailto:bonjour@viteetgourmand.fr">Demander un devis</a>
                        <a class="button button--light-outline" href="tel:+33556002525">04 56 00 25 25</a>
                    </div>
                </div>
                <img src="{{ asset('images/home/signature-dish.webp') }}" width="1200" height="896" loading="lazy" decoding="async" alt="Plat signature de Vite & Gourmand">
            </div>
        </section>
    </main>
{% endblock %}
