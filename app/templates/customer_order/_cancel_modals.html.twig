{% if order.cancellable %}
    <div
        class="modal fade order-placement-modal"
        id="cancelOrderModal"
        tabindex="-1"
        aria-labelledby="cancelOrderModalLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-centered">
            <form
                class="modal-content"
                method="post"
                action="{{ path('app_customer_order_cancel', {id: order.id}) }}"
            >
                <div class="modal-header">
                    <h2 class="modal-title fs-4" id="cancelOrderModalLabel">
                        Annuler la commande
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Confirmez-vous l’annulation de la commande
                        <strong>{{ order.reference }}</strong> ?
                    </p>
                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                    >
                        Retour
                    </button>

                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('cancel_order_' ~ order.id) }}"
                    >

                    <button type="submit" class="btn btn-danger">
                        Confirmer l’annulation
                    </button>
                </div>
            </form>
        </div>
    </div>
{% else %}
    <div
        class="modal fade order-placement-modal"
        id="cancelUnavailableModal"
        tabindex="-1"
        aria-labelledby="cancelUnavailableModalLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2
                        class="modal-title fs-4"
                        id="cancelUnavailableModalLabel"
                    >
                        Annulation impossible
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>
                </div>

                <div class="modal-body">
                    <p>
                        Cette commande ne peut plus être annulée.
                        Contactez-nous pour obtenir plus d’informations.
                    </p>
                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                    >
                        Fermer
                    </button>

                    <a
                        class="btn btn-primary"
                        href="{{ path('app_home') }}#contact"
                    >
                        Contacter l’entreprise
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% set cancellationMessages = app.flashes('order_cancel_success') %}

{% if cancellationMessages is not empty %}
    <div
        class="modal fade order-placement-modal"
        id="cancelSuccessModal"
        data-turbo-temporary
        tabindex="-1"
        aria-labelledby="cancelSuccessModalLabel"
        aria-hidden="true"
        data-controller="order-placement"
        data-order-placement-open-value="true"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-4" id="cancelSuccessModalLabel">
                        Commande annulée
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>
                </div>

                <div class="modal-body">
                    {% for message in cancellationMessages %}
                        <div class="alert alert-success mb-0" role="status">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>

                <div class="modal-footer">
                    <a
                        class="btn btn-primary"
                        href="{{ path('app_customer_order_index') }}"
                    >
                        Mes commandes
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% set unavailableMessages = app.flashes('order_cancel_unavailable') %}

{% if unavailableMessages is not empty %}
    <div
        class="modal fade order-placement-modal"
        id="cancelUnavailableResultModal"
        data-turbo-temporary
        tabindex="-1"
        aria-labelledby="cancelUnavailableResultModalLabel"
        aria-hidden="true"
        data-controller="order-placement"
        data-order-placement-open-value="true"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2
                        class="modal-title fs-4"
                        id="cancelUnavailableResultModalLabel"
                    >
                        Annulation impossible
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"
                    ></button>
                </div>

                <div class="modal-body">
                    {% for message in unavailableMessages %}
                        <div class="alert alert-warning mb-0" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>

                <div class="modal-footer">
                    <a
                        class="btn btn-primary"
                        href="{{ path('app_home') }}#contact"
                    >
                        Contacter l’entreprise
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endif %}